# Copiar a variables de entorno en Dokploy (o .env.local en desarrollo).
# Valores públicos (NEXT_PUBLIC_*) se inyectan en el cliente en tiempo de build.

# Blog / API
NEXT_PUBLIC_API_URL=https://app.polizaderentas.com/api/posts
NEXT_PUBLIC_API_KEY=
API_URL=
API_KEY=

# Imágenes (R2 / metadatos OG)
NEXT_PUBLIC_CLOUDFLARE_R2_ENDPOINT=https://pub-7d69744bfc94470c9f3257d29c3a67d3.r2.dev
CLOUDFLARE_R2_ENDPOINT=

# Formulario de contacto (API route)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# reCAPTCHA (servidor)
RECAPTCHA_SECRET_KEY=

# Puerto: Dokploy suele inyectar PORT; Next.js lo respeta por defecto.
